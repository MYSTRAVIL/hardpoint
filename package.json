{
	"name": "@mystravil/hardpoint",
	"version": "0.5.0",
	"description": "Hardpoint: a Svelte 5 design system on Bits UI. AMOLED black, titanium ink, Geist, square solid blocks, banded mono tables, opt-in expressive motion, dark and light themes.",
	"license": "MIT",
	"author": "MYSTRAVIL",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MYSTRAVIL/hardpoint.git"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"bits-ui",
		"design-system",
		"components"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./fonts.css": "./dist/fonts.css",
		"./tokens.css": "./dist/tokens.css",
		"./base.css": "./dist/base.css",
		"./motion": {
			"types": "./dist/motion/index.d.ts",
			"svelte": "./dist/motion/index.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-lib-imports.mjs && node scripts/check-lib-styles.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"shot": "node scripts/shot.mjs",
		"audit": "node scripts/audit.mjs",
		"consumer": "node scripts/consumer.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"playwright": "^1.65.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"peerDependencies": {
		"svelte": "^5.57.0"
	},
	"dependencies": {
		"@internationalized/date": "^3.8.1",
		"bits-ui": "^2.20.6"
	}
}
